{
  "name": "lugare---marketplace-de-eventos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:user": "VITE_APP_TARGET=user vite build",
    "build:host": "VITE_APP_TARGET=host vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "cap:user:sync": "npm run build:user && CAP_TARGET=user npx cap sync",
    "cap:user:open:ios": "CAP_TARGET=user npx cap open ios",
    "cap:user:open:android": "CAP_TARGET=user npx cap open android",
    "cap:host:sync": "npm run build:host && CAP_TARGET=host npx cap sync",
    "cap:host:open:ios": "CAP_TARGET=host npx cap open ios",
    "cap:host:open:android": "CAP_TARGET=host npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.2",
    "@supabase/supabase-js": "^2.104.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-ga4": "^3.0.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
